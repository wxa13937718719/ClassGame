{
  "id": "03_reading",
  "title": "阅读与表达",
  "questions": [
    {
      "id": "reading_001",
      "type": "single",
      "text": "“月光像流水一样，静静地泻在这一片叶子和花上。”这句话主要运用了哪种修辞手法？（　）",
      "options": [
        {
          "id": "a",
          "content": "比喻"
        },
        {
          "id": "b",
          "content": "拟人"
        },
        {
          "id": "c",
          "content": "排比"
        },
        {
          "id": "d",
          "content": "反问"
        }
      ],
      "answerId": "a",
      "explanation": "句子把“月光”比作“流水”，突出月光流动、清亮的特点，主要运用了比喻。"
    },
    {
      "id": "reading_002",
      "type": "multiple",
      "text": "阅读文章时，下列做法有助于把握文章主旨的有（　）",
      "options": [
        {
          "id": "a",
          "content": "关注标题与开头、结尾"
        },
        {
          "id": "b",
          "content": "梳理反复出现的关键词句"
        },
        {
          "id": "c",
          "content": "完全忽略人物或事件的变化"
        },
        {
          "id": "d",
          "content": "结合写作背景和作者情感线索"
        }
      ],
      "answerIds": [
        "a",
        "b",
        "d"
      ],
      "explanation": "标题、首尾、关键词句以及背景和情感线索都能帮助把握主旨；忽略人物或事件变化会妨碍理解。"
    },
    {
      "id": "reading_003",
      "type": "fill",
      "text": "语言表达要做到准确、简明、连贯。请填写：写作时前后语意衔接自然，属于“______”这一要求。",
      "answers": [
        "连贯"
      ],
      "explanation": "前后语意衔接自然、条理清楚，体现的是语言表达的“连贯”。"
    }
  ]
}
